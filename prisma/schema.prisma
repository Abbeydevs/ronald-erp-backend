generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ApplicationStage {
  CONSULTATION_AND_DOCUMENTS
  COMPLIANCE_REVIEW
  SCHOOL_APPLYING
  OFFER_AND_CONDITIONS
  INTERVIEW_CLEARANCE
  CAS_AND_MEDICALS
  VISA_PREPARATION
  VISA_DECISION_PENDING
}

enum ArchiveReason {
  FINANCIAL_CONSTRAINTS
  GHOSTED_UNRESPONSIVE
  VISA_DENIED
  CHOSE_OTHER_AGENCY
  POSTPONED_NEXT_YEAR
  PERSONAL_REASONS
  OTHER
}

enum CommType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentType {
  PASSPORT
  TRANSCRIPT
  WAEC_NECO_CERTIFICATE
  PASSPORT_DATA_PAGE
  SS1_SS3_TRANSCRIPT
  ACADEMIC_TRANSCRIPT
  CV_RESUME
  STATEMENT_OF_PURPOSE
  BIRTH_CERTIFICATE
  TESTIMONIAL
  IELTS_RESULT
  WORK_REFERENCE_LETTER
  SCHOOL_REFERENCE_LETTER
  HND_BSC_CERTIFICATE
  RESEARCH_PROPOSAL
  BANK_STATEMENT
  MEDICAL
  OFFER_LETTER
  OTHER
}

enum LeadSource {
  FACEBOOK
  WEBSITE
  WALK_IN
  MANUAL
  STAFF
  REFERRAL
}

enum LeadStatus {
  UNASSIGNED
  ASSIGNED
  CONTACTED
  CONVERTED
  LOST
}

enum LeadPriority {
  HOT
  WARM
  COLD
}

enum Role {
  SUPER_ADMIN
  ADMISSIONS_COUNSELLOR
  FINANCE_OFFICER
  VISA_OFFICER
  COMPLIANCE_HR
  SUB_AGENT
  STUDENT
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

model Application {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  stage ApplicationStage @default(CONSULTATION_AND_DOCUMENTS)

  counsellorId String?
  counsellor   User?   @relation("ApplicationCounsellor", fields: [counsellorId], references: [id])
  financeId    String?
  finance      User?   @relation("ApplicationFinance", fields: [financeId], references: [id])
  visaId       String?
  visa         User?   @relation("ApplicationVisa", fields: [visaId], references: [id])

  documents Document[]
  proofs    ProofOfWork[]
  tasks     ApplicationTask[]
  reminders Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("applications")
}

model ApplicationTask {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  title       String
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("application_tasks")
}

model Attendance {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  date     DateTime  @db.Date
  clockIn  DateTime  @default(now())
  clockOut DateTime?

  clockInLat Float?
  clockInLng Float?

  isLate       Boolean @default(false)
  isOvertime   Boolean @default(false)
  isAutoClosed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendances")
}

model Branch {
  id           String @id @default(uuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Float  @default(50)
  openingTime  String @default("09:00")
  closingTime  String @default("18:00")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  attendances Attendance[]

  @@map("branches")
}

model CommunicationLog {
  id           String             @id @default(uuid())
  leadId       String
  counsellorId String
  type         CommType
  duration     Int?
  subject      String?
  content      String?            @db.Text
  recordingUrl String?
  notes        String?
  meetUrl      String?
  scheduledAt  DateTime?
  parentId     String?
  parent       CommunicationLog?  @relation("EmailThread", fields: [parentId], references: [id])
  replies      CommunicationLog[] @relation("EmailThread")

  createdAt DateTime @default(now())

  lead       Lead @relation(fields: [leadId], references: [id])
  counsellor User @relation(fields: [counsellorId], references: [id])

  @@index([leadId])
  @@index([counsellorId])
}

model DailyReport {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        String
  content     String   @db.Text
  submittedAt DateTime @default(now())
  isLate      Boolean  @default(false)

  @@unique([userId, date])
  @@map("daily_reports")
}

model DeviceFingerprint {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fingerprintHash String   @unique
  userAgent       String?
  ipAddress       String?
  lastSeen        DateTime @default(now())

  createdAt DateTime @default(now())

  @@map("device_prints")
}

model Document {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type          DocumentType
  fileUrl       String
  status        DocumentStatus @default(PENDING)
  rejectionNote String?        @db.Text

  verifiedById String?
  verifiedBy   User?   @relation("DocumentVerifier", fields: [verifiedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
}

model EmailDraft {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  to          String
  subject     String?
  body        String? @db.Text
  attachments Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_drafts")
}

model IdleAlert {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lockedAt   DateTime  @default(now())
  unlockedAt DateTime?
  isResolved Boolean   @default(false)

  @@map("idle_alerts")
}

model Invitation {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String   @unique
  role      Role
  expiresAt DateTime
  isUsed    Boolean  @default(false)

  workMode   WorkMode    @default(ONSITE)
  branchId   String?
  remoteDays DayOfWeek[]

  generatedById String
  generatedBy   User   @relation("AdminInvites", fields: [generatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invitations")
}

model Lead {
  id               String  @id @default(uuid())
  firstName        String
  lastName         String
  email            String?
  phone            String?
  countryChoice    String?
  budget           String?
  courseOfStudy    String?
  finalInstitution String?
  counsellorNotes  String? @db.Text

  isArchived    Boolean        @default(false)
  archiveReason ArchiveReason?
  archiveNotes  String?        @db.Text
  archivedAt    DateTime?

  programType String?
  intake      String?
  sponsorType String?

  source   LeadSource   @default(MANUAL)
  status   LeadStatus   @default(UNASSIGNED)
  priority LeadPriority @default(WARM)

  studentId    String?       @unique
  student      User?         @relation("StudentProfile", fields: [studentId], references: [id])
  applications Application[]

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])

  referredById String?
  referredBy   User?   @relation("ReferredLeads", fields: [referredById], references: [id])

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastCommunicatedAt DateTime? @default(now())

  communicationLogs CommunicationLog[]

  @@map("leads")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("password_reset_tokens")
}

model ProofOfWork {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  staffId String
  staff   User   @relation(fields: [staffId], references: [id])

  stageMovedTo ApplicationStage
  fileUrl      String
  notes        String           @db.Text

  createdAt DateTime @default(now())

  @@map("proofs_of_work")
}

model Reminder {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  stage     ApplicationStage?
  note      String            @db.Text
  dueDate   DateTime          @db.Date
  isRead    Boolean           @default(false)
  isEmailed Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reminders")
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  hash     String
  role     Role
  isActive Boolean @default(true)

  isEmailConnected Boolean @default(false)
  integratedEmail  String?
  emailPassword    String?
  emailSignature   String? @db.Text

  branchId   String?
  branch     Branch?     @relation(fields: [branchId], references: [id])
  workMode   WorkMode    @default(ONSITE)
  remoteDays DayOfWeek[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedInvites   Invitation[]        @relation("AdminInvites")
  deviceFingerprints DeviceFingerprint[]
  attendances        Attendance[]
  idleAlerts         IdleAlert[]
  dailyReports       DailyReport[]
  assignedLeads      Lead[]              @relation("AssignedLeads")
  referredLeads      Lead[]              @relation("ReferredLeads")
  communicationLogs  CommunicationLog[]
  reminders          Reminder[]
  emailDrafts        EmailDraft[]

  studentProfile          Lead?         @relation("StudentProfile")
  counsellingApplications Application[] @relation("ApplicationCounsellor")
  financeApplications     Application[] @relation("ApplicationFinance")
  visaApplications        Application[] @relation("ApplicationVisa")
  verifiedDocuments       Document[]    @relation("DocumentVerifier")
  proofsOfWork            ProofOfWork[]

  @@map("users")
}
