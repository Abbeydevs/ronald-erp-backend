generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CommType {
  CALL
  EMAIL
  WHATSAPP
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum LeadSource {
  FACEBOOK
  WEBSITE
  WALK_IN
  MANUAL
}

enum LeadStatus {
  UNASSIGNED
  ASSIGNED
  CONTACTED
  CONVERTED
  LOST
}

enum LeadPriority {
  HOT
  WARM
  COLD
}

enum Role {
  SUPER_ADMIN
  ADMISSIONS_COUNSELLOR
  FINANCE_OFFICER
  VISA_OFFICER
  COMPLIANCE_HR
  SUB_AGENT
  STUDENT
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

model Attendance {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  date     DateTime  @db.Date
  clockIn  DateTime  @default(now())
  clockOut DateTime?

  clockInLat Float?
  clockInLng Float?

  isLate       Boolean @default(false)
  isOvertime   Boolean @default(false)
  isAutoClosed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendances")
}

model Branch {
  id           String @id @default(uuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Float  @default(50)
  openingTime  String @default("09:00")
  closingTime  String @default("18:00")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  attendances Attendance[]

  @@map("branches")
}

model CommunicationLog {
  id           String   @id @default(uuid())
  leadId       String
  counsellorId String
  type         CommType
  duration     Int?
  recordingUrl String?
  notes        String?
  createdAt    DateTime @default(now())

  lead       Lead @relation(fields: [leadId], references: [id])
  counsellor User @relation(fields: [counsellorId], references: [id])
}

model DailyReport {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        String
  content     String   @db.Text
  submittedAt DateTime @default(now())
  isLate      Boolean  @default(false)

  @@unique([userId, date])
  @@map("daily_reports")
}

model DeviceFingerprint {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fingerprintHash String   @unique
  userAgent       String?
  ipAddress       String?
  lastSeen        DateTime @default(now())

  createdAt DateTime @default(now())

  @@map("device_prints")
}

model IdleAlert {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lockedAt   DateTime  @default(now())
  unlockedAt DateTime?
  isResolved Boolean   @default(false)

  @@map("idle_alerts")
}

model Invitation {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String   @unique
  role      Role
  expiresAt DateTime
  isUsed    Boolean  @default(false)

  generatedById String
  generatedBy   User   @relation("AdminInvites", fields: [generatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invitations")
}

model Lead {
  id            String  @id @default(uuid())
  firstName     String
  lastName      String
  email         String?
  phone         String?
  countryChoice String?
  budget        String?
  courseOfStudy String?

  source   LeadSource   @default(MANUAL)
  status   LeadStatus   @default(UNASSIGNED)
  priority LeadPriority @default(WARM)

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  communicationLogs CommunicationLog[]

  @@map("leads")
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  hash     String
  role     Role
  isActive Boolean @default(true)

  branchId   String?
  branch     Branch?     @relation(fields: [branchId], references: [id])
  workMode   WorkMode    @default(ONSITE)
  remoteDays DayOfWeek[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedInvites   Invitation[]        @relation("AdminInvites")
  deviceFingerprints DeviceFingerprint[]
  attendances        Attendance[]
  idleAlerts         IdleAlert[]
  dailyReports       DailyReport[]
  assignedLeads      Lead[]              @relation("AssignedLeads")
  communicationLogs  CommunicationLog[]

  @@map("users")
}
